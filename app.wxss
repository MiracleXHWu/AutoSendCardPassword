/* ============================================================
   app.wxss —— 全局设计系统
   与 design/ui-design-v1.html 一致的色板与尺寸
   ============================================================ */
page {
  --green: #12b76a;
  --green-d: #0f9a59;
  --green-l: #e7f8f0;
  --txt: #101828;
  --sub: #667085;
  --dim: #98a2b3;
  --line: #eceff3;
  --red: #f04438;
  --amber: #f79009;

  /* ---- 浅色暖砂主题（方案 C） ---- */
  --paper: #faf6f0;
  --brand: #c07b3a;
  --brand-d: #a3672a;
  --brand-l: #fbf0e1;
  --ink: #3a2c1c;
  --ink-sub: #8a7458;
  --ink-dim: #b9a894;

  /* ---- 全铺满头部（首页/分类/订单/我的 共用，改这里全站生效） ---- */
  --hero-grad: linear-gradient(168deg, #fdf9f3 0%, #f5ead9 100%);
  --hero-radius: 22px;
  --hero-line: #e8d8bf;

  background: var(--paper);
  color: var(--ink);
  font-size: 14px;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 24px;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

/* ---------- 全铺满页面骨架（自定义导航） ---------- */
/**
 * 用法：
 *   <view class="screen">
 *     <view class="screen-hero" style="padding-top:{{statusBar}}px">
 *       <view class="nav-row" style="height:{{navH}}px;padding-right:{{capsuleGap}}px">
 *         <text class="nav-title">标题</text>
 *       </view>
 *       ...
 *     </view>
 *   </view>
 * statusBar / navH / capsuleGap 由 utils/nav.js 注入，不要各页手写常量。
 */
.screen {
  min-height: 100vh;
  background: var(--paper);
}

.screen-hero {
  background: var(--hero-grad);
  padding: 0 18px 18px;
  border-radius: 0 0 var(--hero-radius) var(--hero-radius);
}

.nav-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
}

.nav-sub {
  margin-left: auto;
  font-size: 11.5px;
  color: var(--ink-sub);
}

/* 半透明玻璃面板：搜索框、统计、手机号行共用 */
.glass {
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid rgba(255, 255, 255, 0.78);
  border-radius: 12px;
}

/* 搜索胶囊：首页与分类页共用 */
.search-pill {
  height: 38px;
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--hero-line);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
}

.search-pill-ico {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
  border: 1.6px solid #a08a6d;
  border-radius: 50%;
  position: relative;
}
.search-pill-ico::after {
  content: '';
  position: absolute;
  right: -3px;
  bottom: -2px;
  width: 6px;
  height: 1.6px;
  background: #a08a6d;
  transform: rotate(45deg);
}

.search-pill-txt {
  color: #a08a6d;
  font-size: 12.5px;
}

.hr {
  height: 1px;
  background: var(--line);
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 13px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
  overflow: hidden;
}

.pane {
  background: #fff;
  border-radius: 12px;
  padding: 14px 14px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
}

.sect {
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  margin: 18px 0 10px;
  display: flex;
  align-items: center;
}

.sect .more {
  margin-left: auto;
  font-size: 12px;
  color: var(--dim);
  font-weight: 400;
}

/* ---------- 文本 ---------- */
.muted {
  color: var(--dim);
  font-size: 12px;
}
.sub {
  color: var(--sub);
  font-size: 12.5px;
}
.strong {
  font-weight: 600;
  color: var(--txt);
}
.mono {
  font-family: ui-monospace, Menlo, Consolas, monospace;
  letter-spacing: 0.02em;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 价格 ---------- */
.price {
  color: var(--red);
  font-weight: 700;
  font-size: 17px;
  line-height: 1.2;
}
.price .unit {
  font-size: 11px;
  font-weight: 700;
  margin-right: 1px;
}
.price-origin {
  color: #b0b8c4;
  font-size: 11.5px;
  text-decoration: line-through;
  margin-left: 5px;
  font-weight: 400;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 46px;
  border-radius: 12px;
  background: var(--green);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: none;
  line-height: 1;
}
.btn::after {
  border: none;
}
.btn.ghost {
  background: #fff;
  color: #344054;
  border: 1px solid #e4e7ec;
  font-weight: 500;
}
.btn.dark {
  background: #101828;
}
.btn.disabled {
  background: #d0d5dd;
  color: #fff;
}
.btn.small {
  height: 34px;
  font-size: 12.5px;
  border-radius: 9px;
  padding: 0 14px;
}
.btn-hover {
  opacity: 0.86;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 10px;
  color: var(--brand-d);
  background: var(--brand-l);
  border-radius: 4px;
  padding: 1px 5px;
  margin-right: 4px;
}
.tag.gray {
  color: #667085;
  background: #f2f4f7;
}
.tag.red {
  color: var(--red);
  background: #fee4e2;
}

/* ---------- 安全区 ---------- */
.bottom-safe {
  height: calc(env(safe-area-inset-bottom) + 8px);
}

/* ---------- 空态 / 加载 ---------- */
.empty {
  padding: 70px 20px;
  text-align: center;
  color: var(--dim);
  font-size: 13px;
  line-height: 1.8;
}
.empty .big {
  font-size: 34px;
  margin-bottom: 10px;
  opacity: 0.5;
}

.skeleton {
  background: linear-gradient(90deg, #eef1f5 25%, #f6f8fa 37%, #eef1f5 63%);
  background-size: 400% 100%;
  animation: shimmer 1.2s ease infinite;
  border-radius: 8px;
}
@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---------- 底部固定操作条 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1px solid var(--line);
  padding: 10px 16px calc(env(safe-area-inset-bottom) + 10px);
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 20;
}
