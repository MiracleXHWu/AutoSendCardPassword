<!-- pages/orders/orders.wxml -->
<view class="orderspage">
  <!-- 顶部统计 + 查单入口 -->
  <view class="head">
    <view class="stats">
      <view class="stat"><text class="n">{{stats.total}}</text><text class="l">全部订单</text></view>
      <view class="stat"><text class="n amber">{{stats.unpaid}}</text><text class="l">待支付</text></view>
      <view class="stat"><text class="n green">{{stats.paid}}</text><text class="l">已支付</text></view>
    </view>
    <view class="query-entry" bindtap="gotoQuery">换设备了？手机号查单 ›</view>
  </view>

  <!-- 筛选 -->
  <view class="tabs">
    <view class="tab {{tab === 'all' ? 'on' : ''}}" data-tab="all" bindtap="switchTab">全部</view>
    <view class="tab {{tab === 'unpaid' ? 'on' : ''}}" data-tab="unpaid" bindtap="switchTab">待支付</view>
    <view class="tab {{tab === 'paid' ? 'on' : ''}}" data-tab="paid" bindtap="switchTab">已支付</view>
  </view>

  <view wx:if="{{loading}}" class="list">
    <view class="ocard" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton" style="height:16px;width:60%"></view>
      <view class="skeleton" style="height:13px;width:40%;margin-top:10px"></view>
    </view>
  </view>

  <view wx:elif="{{!filtered.length}}" class="empty">
    <view class="big">🧾</view>
    <view>{{tab === 'unpaid' ? '没有待支付的订单' : tab === 'paid' ? '还没有已支付的订单' : '还没有订单'}}</view>
    <view class="muted" style="margin-top:6px">下单后可在这里查看卡密与发货内容</view>
    <view class="btn small ghost" style="display:inline-flex;margin-top:16px" bindtap="gotoHome">去逛逛</view>
  </view>

  <view wx:else class="list">
    <view class="ocard" wx:for="{{filtered}}" wx:key="tradeNo">
      <view class="ocard-head">
        <text class="mono muted">{{item.tradeNo}}</text>
        <text class="status {{item.paid ? 'ok' : 'wait'}}">{{item.statusText}}</text>
      </view>

      <view class="ocard-body" data-no="{{item.tradeNo}}" bindtap="gotoDetail">
        <view class="thumb">
          <image wx:if="{{!item.noCover}}" class="thumb-img" src="{{item.cover}}" mode="aspectFill" />
          <text wx:else class="thumb-initial">{{item.initial}}</text>
        </view>
        <view class="flex1">
          <view class="oname clamp2">{{item.name || '商品'}}</view>
          <view class="ometa">{{item.skuText || '默认规格'}} · {{item.num}} 件</view>
        </view>
        <view class="price"><text class="unit">¥</text>{{item.amountText}}</view>
      </view>

      <view class="ocard-foot">
        <text class="muted">{{item.timeText}}</text>
        <view class="actions">
          <view wx:if="{{!item.paid}}" class="btn small" data-no="{{item.tradeNo}}" bindtap="gotoPay">继续支付</view>
          <view wx:else class="btn small ghost" data-no="{{item.tradeNo}}" bindtap="gotoDetail">查看卡密</view>
        </view>
      </view>
    </view>
  </view>

  <view style="height:130rpx"></view>
</view>
