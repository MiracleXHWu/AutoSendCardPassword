<!-- pages/goods/goods.wxml —— 商品详情（扫码落地页） -->

<!-- 骨架屏 -->
<view wx:if="{{loading}}" class="wrap">
  <view class="hero">
    <view class="skel s-title"></view>
    <view class="skel s-line"></view>
    <view class="skel s-line s-short"></view>
    <view class="skel s-price"></view>
  </view>
  <view class="card">
    <view class="skel s-line"></view>
    <view class="skel s-line s-short"></view>
  </view>
</view>

<!-- 云环境未就绪：扫码落地页尤其需要可操作的提示，否则用户只会看到「商品不存在」 -->
<view wx:elif="{{envIssue}}" class="wrap">
  <view class="envcard">
    <view class="envcard-head">
      <view class="envcard-icon">🔧</view>
      <view class="envcard-meta">
        <view class="envcard-title">{{envIssue.title}}</view>
        <view class="envcard-desc">{{envIssue.message}}</view>
      </view>
    </view>

    <view class="envcard-steps">
      <view class="envstep">
        <text class="envstep-n">1</text>
        <text>换掉游客号：云开发不支持游客号/测试号，请在「详情 → 基本信息」换成你自己的 AppID</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">2</text>
        <text>点工具栏左侧「云开发」按钮，新建一个环境</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">3</text>
        <text>把环境 ID 填进 miniprogram/config.js 的 cloudEnv</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">4</text>
        <text>部署 6 个云函数，并运行一次 initdb</text>
      </view>
    </view>

    <view class="btn-primary" hover-class="pressed" bindtap="goSetup">查看完整配置指引</view>
    <view class="btn-ghost envcard-retry" hover-class="pressed" bindtap="retryEnv">
      我已配置好，重新自检
    </view>
  </view>
</view>

<!-- 商品不存在 -->
<view wx:elif="{{notFound}}" class="empty">
  <view class="emoji">🔍</view>
  <view class="title">商品不存在或已下架</view>
  <view class="desc">请确认扫码来源是否有效，或返回首页浏览其他内容</view>
  <view class="env-diagnose" bindtap="goSetup">运行环境自检 ›</view>
</view>

<block wx:else>
  <view class="wrap">
    <!-- 商品头部 -->
    <view class="hero">
      <view class="hero-chip" wx:if="{{fromScan}}">扫码进入</view>
      <view class="hero-title">{{goods.title}}</view>
      <view class="hero-desc" wx:if="{{goods.desc}}">{{goods.desc}}</view>
      <view class="hero-price">
        <!-- 价格不合法时宁可不出金额：显示「¥—」会让顾客以为是标价，干脆换成状态词 -->
        <view class="price" wx:if="{{!priceInvalid}}">
          <text class="sym">¥</text>
          <text class="num">{{priceText}}</text>
        </view>
        <view class="price-todo" wx:else>维护中</view>
        <view class="tag tag-ok">{{goods.deliveryMode === 'pool' ? '一人一码' : '付款即发货'}}</view>
      </view>
    </view>

    <!-- 价格未正确配置：不显示金额、不允许下单。
         给顾客看的是「为什么买不了」，给开发者看的是「具体哪一步没配对」。
         两者的边界靠 devHints 划开——正式版顾客看不到任何后台配置信息。 -->
    <view class="card cfgcard" wx:if="{{priceInvalid}}">
      <view class="cfgcard-head">
        <view class="cfgcard-icon">!</view>
        <view class="cfgcard-title">该商品暂不可购买</view>
      </view>
      <view class="cfgcard-item">商品信息正在维护中，请稍后再试；如有疑问可点本页底部「联系客服」。</view>

      <block wx:if="{{devHints}}">
        <view class="cfgcard-dev">开发提示（正式版不显示）</view>
        <view class="cfgcard-item">原因：{{priceReason}}</view>
        <view class="cfgcard-item">
          修法：云开发控制台 →「数据库」→ goods → 找到本商品的记录，把 price 改成 <text class="mono">数字</text> 类型的整数分（9.90 元填 <text class="mono">990</text>），不要用文本、不要带小数。
        </view>
        <view class="btn-ghost cfgcard-btn" hover-class="pressed" bindtap="goSetup">
          运行环境自检 ›
        </view>
      </block>
    </view>

    <!-- 你将获得 -->
    <view class="card">
      <view class="sec-title">你将获得</view>
      <view class="perk" wx:for="{{perks}}" wx:key="index">
        <view class="perk-icon">{{item.icon}}</view>
        <view class="perk-text">{{item.text}}</view>
      </view>
    </view>

    <!-- 发货流程 -->
    <view class="card">
      <view class="sec-title">发货流程</view>
      <view class="step">
        <view class="step-n">1</view>
        <view class="step-t">点击下方「立即购买」，完成微信支付</view>
      </view>
      <view class="step">
        <view class="step-n">2</view>
        <view class="step-t">支付成功后系统自动发货，无需等待人工</view>
      </view>
      <view class="step">
        <view class="step-n">3</view>
        <view class="step-t">链接与提取码立刻显示，支持一键复制</view>
      </view>
      <view class="step">
        <view class="step-n">4</view>
        <view class="step-t">内容永久保存，可在「我的订单」随时重看</view>
      </view>
    </view>

    <!-- 购买须知 -->
    <view class="card">
      <view class="sec-title">购买须知</view>
      <view class="notice">{{notice}}</view>
      <view class="divider"></view>
      <button class="contact" open-type="contact" session-from="goods-detail">
        遇到问题？联系客服 →
      </button>
    </view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="footbar">
    <view class="left">
      <view class="price" wx:if="{{!priceInvalid}}">
        <text class="sym">¥</text>
        <text class="num">{{priceText}}</text>
      </view>
      <view class="muted">{{priceInvalid ? '该商品暂不可购买' : '付款成功后自动发送'}}</view>
    </view>
    <view class="action">
      <view
        class="{{buying || priceInvalid ? 'btn-primary is-disabled' : 'btn-primary'}}"
        hover-class="pressed"
        bindtap="onBuy"
      >
        {{priceInvalid ? '暂不可购买' : (buying ? '处理中…' : '立即购买')}}
      </view>
    </view>
  </view>
</block>
