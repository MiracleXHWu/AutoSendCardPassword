<!-- pages/index/index.wxml -->
<view class="page index">
  <!-- 顶部：搜索 + 分类快捷 -->
  <view class="hero" style="padding-top:{{statusBar + 10}}px">
    <view class="hero-top">
      <view class="hero-title">
        <view class="brand">{{appName}}</view>
        <view class="slogan">付款即刻自动发货 · 全程自助</view>
      </view>
    </view>

    <view class="srch" bindtap="gotoSearch">
      <view class="srch-ico"></view>
      <text class="srch-txt">搜索商品名称 / 关键词</text>
    </view>

    <view class="hero-stats">
      <view class="hs"><text class="hs-n">{{goods.length}}</text><text class="hs-l">在售商品</text></view>
      <view class="hs-line"></view>
      <view class="hs"><text class="hs-n">{{categories.length}}</text><text class="hs-l">商品分类</text></view>
      <view class="hs-line"></view>
      <view class="hs"><text class="hs-n">7×24</text><text class="hs-l">自动发货</text></view>
    </view>
  </view>

  <!-- 分类 -->
  <scroll-view class="cat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        class="cat {{activeKey === '0' ? 'on' : ''}}"
        data-key="0"
        bindtap="switchCat"
      >全部</view>
      <view
        class="cat {{activeKey === item.key ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchCat"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view class="body">
    <view wx:if="{{loading}}" class="grid">
      <view class="gcard" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="gcover skeleton"></view>
        <view class="gbody">
          <view class="skeleton" style="height:14px;width:86%"></view>
          <view class="skeleton" style="height:14px;width:52%;margin-top:8px"></view>
          <view class="skeleton" style="height:18px;width:40%;margin-top:12px"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{error}}" class="empty">
      <view class="big">⚠</view>
      <view>{{error}}</view>
      <view class="retry-btn" bindtap="retry">重新加载</view>
    </view>

    <view wx:elif="{{!goods.length}}" class="empty">
      <view class="big">🛒</view>
      <view>这个分类下还没有上架商品</view>
      <view class="muted" style="margin-top:6px">换个分类看看，或下拉刷新</view>
    </view>

    <view wx:else class="grid">
      <view class="gcard" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="gotoGoods">
        <view class="gcover" style="background:{{item.bg}}">
          <image
            wx:if="{{!item.noCover}}"
            class="gimg"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
          />
          <text wx:else class="ginitial">{{item.initial}}</text>
          <view wx:if="{{item.recommend}}" class="badge">推荐</view>
          <view wx:if="{{item.stock <= 0}}" class="soldout">已售罄</view>
          <view wx:elif="{{item.seckill}}" class="badge right">限时</view>
        </view>
        <view class="gbody">
          <view class="gname clamp2">{{item.name}}</view>
          <view class="gtags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="name" wx:if="{{index < 2}}">{{t.name}}</text>
            <text wx:if="{{!item.tags.length}}" class="tag gray">{{item.categoryName || '自动发货'}}</text>
          </view>
          <view class="gfoot">
            <view class="price"><text class="unit">¥</text>{{item.userPriceText}}</view>
            <text wx:if="{{item.hasDiscount}}" class="price-origin">¥{{item.priceText}}</text>
            <text class="gsold">已售 {{item.soldText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="muted" style="text-align:center;padding:16px">加载中…</view>
    <view wx:elif="{{!hasMore && goods.length}}" class="muted" style="text-align:center;padding:16px">已经到底了</view>
  </view>

  <view style="height:120rpx"></view>
</view>
