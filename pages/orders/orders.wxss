/* pages/orders/orders.wxss */
.orderspage {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 0;
}

/* 头部：渐变底由 .screen-hero 提供，这里只排统计与入口 */
.stats {
  margin-top: 12px;
  display: flex;
  align-items: center;
  padding: 13px 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .n {
  font-size: 19px;
  font-weight: 700;
  color: var(--ink);
}

.stat .n.amber {
  color: #d9822b;
}

.stat .n.green {
  color: #4f9d6b;
}

.stat .l {
  font-size: 10.5px;
  color: var(--ink-sub);
  margin-top: 3px;
}

.query-entry {
  margin-top: 12px;
  text-align: center;
  font-size: 11.5px;
  color: var(--brand-d);
  background: rgba(251, 240, 225, 0.85);
  border: 1px solid rgba(232, 216, 191, 0.7);
  border-radius: 9px;
  padding: 9px;
}

/* 筛选 */
.tabs {
  display: flex;
  background: var(--paper);
  padding: 0 16px;
  border-bottom: 1px solid rgba(58, 44, 28, 0.08);
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 13px;
  color: var(--ink-sub);
  padding: 12px 0 11px;
  position: relative;
}

.tab.on {
  color: var(--ink);
  font-weight: 600;
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 22px;
  height: 2.5px;
  border-radius: 2px;
  background: var(--brand);
}

/* 列表 */
.list {
  padding: 12px 16px 0;
}

.ocard {
  background: #fff;
  border-radius: 13px;
  padding: 12px 13px;
  margin-bottom: 11px;
  box-shadow: 0 1px 2px rgba(90, 64, 32, 0.06);
}

.ocard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f4ece0;
}

.status {
  font-size: 11px;
  font-weight: 600;
}

.status.ok {
  color: #4f9d6b;
}

.status.wait {
  color: #d9822b;
}

.ocard-body {
  display: flex;
  gap: 11px;
  align-items: center;
  padding: 11px 0;
}

.thumb {
  width: 56px;
  height: 56px;
  flex: 0 0 56px;
  border-radius: 9px;
  background: linear-gradient(135deg, #f7f1e7, #ece0cd);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-initial {
  font-size: 22px;
  font-weight: 700;
  color: rgba(58, 44, 28, 0.18);
}

.oname {
  font-size: 13px;
  line-height: 1.45;
  color: var(--ink);
}

.ometa {
  font-size: 11px;
  color: var(--ink-dim);
  margin-top: 4px;
}

.ocard-body .price {
  font-size: 15px;
  flex: 0 0 auto;
  margin-left: 8px;
}

.ocard-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10px;
  border-top: 1px solid #f4ece0;
}

.actions {
  display: flex;
  gap: 8px;
}
