<!-- pages/index/index.wxml —— 商品列表 -->

<!-- 骨架屏 -->
<view wx:if="{{loading}}" class="wrap">
  <view class="banner">
    <view class="banner-title">优质数字资料</view>
    <view class="banner-desc">付款成功后自动发货，内容永久可查</view>
  </view>
  <view class="gcard" wx:for="{{[1,2,3]}}" wx:key="*this">
    <view class="skel s-title"></view>
    <view class="skel s-line"></view>
    <view class="skel s-price"></view>
  </view>
</view>

<!-- 云环境未就绪：给出可操作的配置指引，而不是一句「加载失败」 -->
<view wx:elif="{{envIssue}}" class="wrap">
  <view class="envcard">
    <view class="envcard-head">
      <view class="envcard-icon">🔧</view>
      <view class="envcard-meta">
        <view class="envcard-title">{{envIssue.title}}</view>
        <view class="envcard-desc">{{envIssue.message}}</view>
      </view>
    </view>

    <view class="envcard-steps">
      <view class="envstep">
        <text class="envstep-n">1</text>
        <text>换掉游客号：云开发不支持游客号/测试号，请在「详情 → 基本信息」换成你自己的 AppID</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">2</text>
        <text>点工具栏左侧「云开发」按钮，新建一个环境</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">3</text>
        <text>把环境 ID 填进 miniprogram/config.js 的 cloudEnv</text>
      </view>
      <view class="envstep">
        <text class="envstep-n">4</text>
        <text>部署 6 个云函数，并运行一次 initdb</text>
      </view>
    </view>

    <view class="btn-primary" hover-class="pressed" bindtap="goSetup">查看完整配置指引</view>
    <view class="btn-ghost envcard-retry" hover-class="pressed" bindtap="retryEnv">
      我已配置好，重新自检
    </view>
  </view>
</view>

<!-- 加载失败 -->
<view wx:elif="{{failed}}" class="empty">
  <view class="emoji">⚠️</view>
  <view class="title">加载失败</view>
  <view class="desc">请检查云开发环境是否已开通、goods 集合是否已初始化</view>
  <view class="empty-acts">
    <view class="empty-btn" bindtap="loadGoods" hover-class="pressed">重新加载</view>
    <view class="env-diagnose" bindtap="goSetup" hover-class="pressed">运行环境自检 ›</view>
  </view>
</view>

<!-- 有商品 -->
<block wx:elif="{{goods.length}}">
  <view class="wrap">
    <view class="banner">
      <view class="banner-title">优质数字资料</view>
      <view class="banner-desc">付款成功后自动发货，内容永久可查</view>
      <view class="banner-tags">
        <view class="btag">秒发货</view>
        <view class="btag">可复制</view>
        <view class="btag">永久保存</view>
      </view>
    </view>

    <!-- 仅开发者工具/体验版可见：商品数据由云函数管理端代读，建议开放集合读权限 -->
    <view class="permnote" wx:if="{{permWarn}}">
      <view class="permnote-head">
        <text class="permnote-badge">开发提示</text>
        <text class="permnote-title">goods 集合读权限尚未开放</text>
      </view>
      <view class="permnote-body">
        当前商品由云函数以管理端权限代读，功能正常，只是每次多一次云函数调用。到云开发控制台「数据库 → goods → 权限设置」选「所有用户可读，仅管理端可写」即可省掉这一步。正式版不会显示本提示。
      </view>
      <view class="permnote-link" bindtap="goSetup" hover-class="pressed">查看图文步骤 ›</view>
    </view>

    <!-- 仅开发者工具/体验版可见：有商品价格不合法，页面显示「¥—」且不可购买 -->
    <view class="permnote warnnote" wx:if="{{cfgWarn}}">
      <view class="permnote-head">
        <text class="permnote-badge warn">开发提示</text>
        <text class="permnote-title">有商品价格未正确配置</text>
      </view>
      <view class="permnote-body">
        商品 {{cfgWarnIds}} 的 price 字段不合法，页面会显示「¥—」并禁止下单（避免按错误金额扣款）。到云开发控制台「数据库 → goods」把 price 改成数字类型的整数分（9.90 元填 990）。在「运行环境自检」页可一键体检并修复示例商品。正式版不会显示本提示。
      </view>
      <view class="permnote-link" bindtap="goSetup" hover-class="pressed">运行环境自检 ›</view>
    </view>

    <view
      class="gcard"
      wx:for="{{goods}}"
      wx:key="_id"
      data-pid="{{item.productId}}"
      bindtap="goDetail"
      hover-class="pressed"
    >
      <view class="gcard-main">
        <view class="gicon">{{item.icon}}</view>
        <view class="gmeta">
          <view class="gtitle">{{item.title}}</view>
          <view class="gdesc">{{item.desc}}</view>
          <view class="tag tag-ok gmode">
            {{item.deliveryMode === 'pool' ? '一人一码' : '付款即发货'}}
          </view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="gcard-foot">
        <view class="price">
          <text class="sym">¥</text>
          <text class="num">{{item.priceText}}</text>
        </view>
        <view class="gbuy">{{item.priceBad ? '暂不可购买' : '立即购买'}}</view>
      </view>
    </view>
  </view>
</block>

<!-- 空态：文案由 emptyCopy() 按实际情况生成 -->
<view wx:else class="empty">
  <view class="emoji">🛍️</view>
  <view class="title">{{emptyTitle || '还没有上架的商品'}}</view>
  <view class="desc">{{emptyDesc || '请先在云数据库 goods 集合中添加商品，或在开发者工具里对 initdb 云函数执行一次「云端测试」'}}</view>
  <view class="empty-acts">
    <view class="empty-btn" hover-class="pressed" bindtap="retryEnv">{{emptyBtn}}</view>
    <view class="env-diagnose" bindtap="goSetup" hover-class="pressed">运行环境自检 ›</view>
  </view>
</view>
