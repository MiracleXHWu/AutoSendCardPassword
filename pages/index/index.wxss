/* pages/index/index.wxss */
.index {
  padding-bottom: 0;
}

/* ---------- Hero ----------
 * 渐变底、圆角、左右内边距统一由 app.wxss 的 .screen-hero 提供，
 * 这里只保留首页特有的文字与统计排版。
 */
.hero-top {
  display: flex;
  align-items: flex-start;
  padding-top: 10px;
  box-sizing: border-box;
}

.hero-title {
  min-width: 0;
  flex: 1;
}

.brand {
  color: #3a2c1c;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.slogan {
  color: #8a7458;
  font-size: 11.5px;
  margin-top: 5px;
}

.hero-stats {
  margin-top: 16px;
  display: flex;
  align-items: center;
  padding: 10px 0;
}

.hs {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-n {
  color: #3a2c1c;
  font-size: 15px;
  font-weight: 700;
}

.hs-l {
  color: #8a7458;
  font-size: 10.5px;
  margin-top: 2px;
}

.hs-line {
  width: 1px;
  height: 22px;
  background: rgba(58, 44, 28, 0.12);
}

/* ---------- 分类 ---------- */
.cat-scroll {
  margin-top: 12px;
  white-space: nowrap;
}

.cat-row {
  display: flex;
  gap: 8px;
  padding: 0 16px 4px;
}

.cat {
  flex: 0 0 auto;
  font-size: 12.5px;
  color: #8a7458;
  background: #fff;
  border: 1px solid rgba(58, 44, 28, 0.12);
  padding: 6px 14px;
  border-radius: 999px;
  line-height: 1.2;
}

.cat.on {
  background: #c07b3a;
  color: #fff;
  border-color: #c07b3a;
  font-weight: 600;
}

/* ---------- 网格 ---------- */
.body {
  padding: 6px 16px 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.gcard {
  width: 48.6%;
  background: #fff;
  border-radius: 13px;
  overflow: hidden;
  margin-bottom: 12px;
  box-shadow: 0 1px 2px rgba(90, 64, 32, 0.07);
}

.gcover {
  position: relative;
  height: 132px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.gimg {
  width: 100%;
  height: 100%;
  display: block;
}

.ginitial {
  font-size: 38px;
  font-weight: 700;
  color: rgba(58, 44, 28, 0.18);
}

/* 推荐角标：红色底，与「限时」的绿色区分开 */
.badge {
  position: absolute;
  left: 7px;
  top: 7px;
  font-size: 9.5px;
  color: #fff;
  background: #f04438;
  padding: 2px 6px;
  border-radius: 4px;
  line-height: 1.4;
}

.badge.right {
  left: auto;
  right: 7px;
  background: #f79009;
}

.soldout {
  position: absolute;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  color: #fff;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1px;
}

.gbody {
  padding: 9px 10px 10px;
}

.gname {
  font-size: 12.5px;
  line-height: 1.45;
  height: 36px;
  color: #3a2c1c;
}

.gtags {
  margin-top: 5px;
  height: 16px;
  overflow: hidden;
}

.gfoot {
  display: flex;
  align-items: baseline;
  margin-top: 7px;
}

.gfoot .price {
  font-size: 15px;
}

.gsold {
  margin-left: auto;
  font-size: 10px;
  color: #b9a894;
}

.retry-btn {
  display: inline-block;
  margin-top: 14px;
  font-size: 13px;
  color: #c07b3a;
  border: 1px solid #eadcc7;
  border-radius: 8px;
  padding: 7px 18px;
}
