/* pages/help/help.wxss */
.helppage {
  min-height: 100vh;
  background: #faf6f0;
  padding: 12px 16px 0;
}

.block {
  margin-bottom: 11px;
  padding: 14px;
}

.block-title {
  font-size: 13.5px;
  font-weight: 600;
  color: #101828;
  margin-bottom: 9px;
}

/* 查单 */
.q-row {
  display: flex;
  gap: 9px;
}

.q-input {
  flex: 1;
  height: 40px;
  background: #f7f8fa;
  border-radius: 9px;
  padding: 0 12px;
  font-size: 13.5px;
}

.ph {
  color: #b0b8c4;
  font-size: 13px;
}

.q-btn {
  width: 74px;
  height: 40px;
  flex: 0 0 74px;
  border-radius: 9px;
  background: #12b76a;
  color: #fff;
  font-size: 13.5px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.q-hint {
  margin-top: 9px;
  font-size: 11.5px;
  color: #12b76a;
}

.q-result {
  margin-top: 12px;
  border-top: 1px solid #f4f6f8;
  padding-top: 4px;
}

.q-error {
  font-size: 12px;
  color: #f04438;
  padding: 10px 0;
}

.q-empty {
  font-size: 12px;
  color: #98a2b3;
  padding: 12px 0;
}

.q-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 0;
  border-bottom: 1px solid #f7f8fa;
}

.q-item:last-child {
  border-bottom: none;
}

.q-name {
  font-size: 13px;
  color: #101828;
}

.q-meta {
  font-size: 10.5px;
  color: #98a2b3;
  margin-top: 4px;
}

.q-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;
  flex: 0 0 auto;
}

.q-amount {
  font-size: 13px;
  font-weight: 600;
  color: #101828;
}

.q-status {
  font-size: 10.5px;
}

.q-status.ok {
  color: #12b76a;
}

.q-status.wait {
  color: #f79009;
}

/* 客服 */
.contact-row {
  display: flex;
  gap: 10px;
  margin-top: 13px;
}

.contact-row .btn {
  flex: 1;
  height: 40px;
  font-size: 13.5px;
}

/* FAQ */
.faq {
  border-top: 1px solid #f7f8fa;
}

.faq:first-of-type {
  border-top: none;
}

.faq-q {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 13px 0;
  font-size: 13px;
  color: #101828;
  line-height: 1.5;
}

.faq-arrow {
  color: #b0b8c4;
  font-size: 14px;
  transition: transform 0.15s;
  flex: 0 0 auto;
}

.faq-arrow.open {
  transform: rotate(180deg);
}

.faq-a {
  font-size: 12.5px;
  color: #667085;
  line-height: 1.85;
  padding: 0 0 13px;
  border-top: 1px dashed #f2f4f7;
  padding-top: 10px;
  margin-top: -2px;
}
