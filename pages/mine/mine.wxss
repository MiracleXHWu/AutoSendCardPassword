/* pages/mine/mine.wxss */
.minepage {
  min-height: 100vh;
  background: #f5f6f8;
}

/* 头部 */
.hero {
  background: linear-gradient(165deg, #0f2a1d, #0b1a14);
  padding: 22px 18px 16px;
  border-radius: 0 0 20px 20px;
}

.user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #cfe6da;
  font-size: 20px;
  font-weight: 600;
}

.uname {
  color: #fff;
  font-size: 17px;
  font-weight: 600;
}

.ustatus {
  color: #7fa290;
  font-size: 11px;
  margin-top: 4px;
}

.login-btn {
  color: #cfe6da;
  font-size: 12px;
  border: 1px solid rgba(207, 230, 218, 0.3);
  border-radius: 999px;
  padding: 6px 14px;
  flex: 0 0 auto;
}

.phone-row {
  margin-top: 16px;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 11px;
  padding: 11px 13px;
}

.phone-label {
  color: #8fb3a2;
  font-size: 12px;
  width: 60px;
}

.phone-val {
  flex: 1;
  color: #e7f4ec;
  font-size: 12.5px;
}

.phone-arrow {
  color: #6d8a7c;
  font-size: 14px;
}

/* 统计 */
.stats-card {
  margin: -14px 16px 0;
  position: relative;
  background: #fff;
  border-radius: 14px;
  padding: 15px 0;
  display: flex;
  box-shadow: 0 6px 18px -12px rgba(16, 24, 40, 0.3);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .n {
  font-size: 18px;
  font-weight: 700;
  color: #101828;
}

.stat .n.amber {
  color: #f79009;
}

.stat .n.green {
  color: #12b76a;
}

.stat .l {
  font-size: 10.5px;
  color: #98a2b3;
  margin-top: 3px;
}

/* 菜单 */
.menu {
  margin: 12px 16px 0;
  background: #fff;
  border-radius: 13px;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 14px 14px;
  font-size: 13.5px;
  color: #344054;
}

.menu-item + .menu-item {
  border-top: 1px solid #f4f6f8;
}

.mi-ico {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.mi-order {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2312b76a' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M5 4.6A1.6 1.6 0 0 1 6.6 3h10.8A1.6 1.6 0 0 1 19 4.6V21l-3.5-2.2L12 21l-3.5-2.2L5 21z'/%3E%3Cpath d='M9 8.4h6M9 12.4h4'/%3E%3C/svg%3E");
}

.mi-search {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232e90fa' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='11' cy='11' r='7'/%3E%3Cpath d='M16.5 16.5 21 21'/%3E%3C/svg%3E");
}

.mi-help {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f79009' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='9'/%3E%3Cpath d='M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3M12 17h.01'/%3E%3C/svg%3E");
}

.mi-info {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2398a2b3' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='9'/%3E%3Cpath d='M12 11v5M12 8h.01'/%3E%3C/svg%3E");
}

.mi-text {
  flex: 1;
}

.mi-arrow {
  color: #d0d5dd;
  font-size: 15px;
}

/* 其它 */
.logout {
  margin: 14px 16px 0;
  text-align: center;
  font-size: 12.5px;
  color: #f04438;
  background: #fff;
  border-radius: 12px;
  padding: 13px;
}

.foot {
  text-align: center;
  margin-top: 26px;
  font-size: 11.5px;
  color: #b0b8c4;
}
