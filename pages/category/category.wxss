/* pages/category/category.wxss */
.catpage {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6f8;
}

.searchbar {
  padding: 8px 16px 10px;
  background: #fff;
}

.srch {
  height: 34px;
  border-radius: 17px;
  background: #eef1f5;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  color: #98a2b3;
  font-size: 12.5px;
}

.srch-ico {
  width: 13px;
  height: 13px;
  border: 1.6px solid #98a2b3;
  border-radius: 50%;
  position: relative;
}
.srch-ico::after {
  content: '';
  position: absolute;
  right: -3px;
  bottom: -2px;
  width: 5px;
  height: 1.5px;
  background: #98a2b3;
  transform: rotate(45deg);
}

.split {
  flex: 1;
  display: flex;
  min-height: 0;
}

/* 左侧 */
.side {
  width: 96px;
  flex: 0 0 96px;
  background: #f0f2f5;
  height: 100%;
}

.side-item {
  padding: 15px 10px;
  font-size: 12.5px;
  color: #667085;
  text-align: center;
  position: relative;
  line-height: 1.35;
}

.side-item.on {
  background: #fff;
  color: #101828;
  font-weight: 600;
}

.side-item.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 16px;
  background: #12b76a;
  border-radius: 0 2px 2px 0;
}

.side-empty {
  padding: 20px 10px;
  font-size: 12px;
  color: #98a2b3;
  text-align: center;
}

/* 右侧 */
.main {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 12px;
  min-width: 0;
}

.main-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14px 2px 8px;
}

.main-title {
  font-size: 15px;
  font-weight: 700;
  color: #101828;
}

.main-count {
  font-size: 11px;
  color: #98a2b3;
}

.sub-scroll {
  white-space: nowrap;
  margin-bottom: 4px;
}

.sub-row {
  display: flex;
  gap: 7px;
  padding-bottom: 6px;
}

.sub {
  flex: 0 0 auto;
  font-size: 11.5px;
  color: #667085;
  background: #f4f6f8;
  border-radius: 6px;
  padding: 5px 10px;
  line-height: 1.2;
}

.sub.on {
  background: #e7f8f0;
  color: #0f9a59;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 6px;
}

.gcard {
  width: 48.5%;
  border: 1px solid #f2f4f7;
  border-radius: 11px;
  overflow: hidden;
  margin-bottom: 10px;
}

.gcover {
  position: relative;
  height: 104px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.gimg {
  width: 100%;
  height: 100%;
}

.ginitial {
  font-size: 30px;
  font-weight: 700;
  color: rgba(16, 24, 40, 0.16);
}

.soldout {
  position: absolute;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  color: #fff;
  font-size: 11.5px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gbody {
  padding: 8px 9px 9px;
}

.gname {
  font-size: 12px;
  line-height: 1.4;
  height: 34px;
  color: #101828;
}

.gfoot {
  display: flex;
  align-items: baseline;
  margin-top: 5px;
}

.gfoot .price {
  font-size: 14px;
}

.gsold {
  margin-left: auto;
  font-size: 9.5px;
  color: #98a2b3;
}

.retry-btn {
  display: inline-block;
  margin-top: 14px;
  font-size: 13px;
  color: #12b76a;
  border: 1px solid #b7e8cf;
  border-radius: 8px;
  padding: 7px 18px;
}
