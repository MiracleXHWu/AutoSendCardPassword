<!-- pages/mine/mine.wxml -->
<view class="minepage">
  <!-- 身份卡：全铺满渐变头（替代原生白底导航栏） -->
  <view class="screen-hero" style="padding-top:{{statusBar}}px">
    <view class="nav-row" style="height:{{navH}}px;padding-right:{{capsuleGap}}px">
      <text class="nav-title">我的</text>
    </view>

    <view class="user">
      <view class="avatar">
        <image wx:if="{{profile.avatar}}" class="avatar-img" src="{{profile.avatar}}" mode="aspectFill" />
        <text wx:else class="avatar-text">{{guest ? '游' : (profile.nickname ? profile.nickname[0] : '我')}}</text>
      </view>
      <view class="flex1">
        <view class="uname">{{guest ? '游客' : (profile.nickname || '微信用户')}}</view>
        <view class="ustatus">
          <text wx:if="{{!guest}}">已登录 · openid {{profile.openid ? '已绑定' : '未获取'}}</text>
          <text wx:else>未登录，下单与查单仍可用</text>
        </view>
      </view>
      <view wx:if="{{guest}}" class="login-btn" bindtap="gotoLogin">登录</view>
      <view wx:else class="login-btn" bindtap="reLogin">刷新</view>
    </view>

    <view class="phone-row glass" bindtap="editPhone">
      <text class="phone-label">手机号</text>
      <text class="phone-val">{{phoneMasked || '未填写（选填）'}}</text>
      <text class="phone-arrow">›</text>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-card">
    <view class="stat" bindtap="gotoOrders">
      <text class="n">{{stats.total}}</text>
      <text class="l">全部订单</text>
    </view>
    <view class="stat" bindtap="gotoUnpaid">
      <text class="n amber">{{stats.unpaid}}</text>
      <text class="l">待支付</text>
    </view>
    <view class="stat" bindtap="gotoOrders">
      <text class="n green">{{stats.paid}}</text>
      <text class="l">已支付</text>
    </view>
    <view class="stat" bindtap="gotoCategory">
      <text class="n">{{catCount}}</text>
      <text class="l">商品分类</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu">
    <view class="menu-item" bindtap="gotoOrders">
      <view class="mi-ico mi-order"></view>
      <text class="mi-text">我的订单</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="gotoQuery">
      <view class="mi-ico mi-search"></view>
      <text class="mi-text">手机号 / 订单号查单</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="gotoHelp">
      <view class="mi-ico mi-help"></view>
      <text class="mi-text">帮助与客服</text>
      <text class="mi-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="about">
      <view class="mi-ico mi-info"></view>
      <text class="mi-text">关于本店</text>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{!guest}}" class="logout" bindtap="logout">退出登录</view>

  <view class="foot">
    <view>{{appName}}</view>
    <view class="muted" style="margin-top:4px">商品与卡密由发卡平台实时提供</view>
  </view>

  <view style="height:130rpx"></view>
</view>
