/* pages/orders/orders.wxss */

/* 自定义 tabBar 占位 */
.wrap {
  padding-bottom: 240rpx;
}

.ocard {
  background: #fff;
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.ocard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocard-name {
  flex: 1;
  min-width: 0;
  margin-right: 18rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ocard-time {
  margin-top: 12rpx;
}

.ocard-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ocard-link {
  font-size: 25rpx;
  color: #576b95;
}

/* 骨架屏 */
.s-line {
  height: 28rpx;
  width: 65%;
  margin-bottom: 22rpx;
}

.s-line.short {
  width: 40%;
}

.s-price {
  height: 44rpx;
  width: 30%;
}

/* 空态按钮（与首页一致） */
.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 52rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14c46f, #059a57);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
