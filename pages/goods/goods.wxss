/* pages/goods/goods.wxss */
.goodspage {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 0;
}

/* 封面 */
.cover {
  height: 300px;
  background: linear-gradient(135deg, #e9f6ef, #d5eee2);
  position: relative;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-blank {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-initial {
  font-size: 72px;
  font-weight: 700;
  color: rgba(16, 24, 40, 0.12);
}

/* 主信息 */
.main-card {
  margin: -18px 16px 0;
  position: relative;
  background: #fff;
  border-radius: 16px;
  padding: 15px 15px 14px;
  box-shadow: 0 6px 20px -12px rgba(16, 24, 40, 0.28);
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price.big {
  font-size: 25px;
}

.price.big .unit {
  font-size: 13px;
}

.sold {
  margin-left: auto;
  font-size: 11.5px;
  color: #98a2b3;
}

.title {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.45;
  color: #101828;
  margin-top: 10px;
}

.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 9px;
}

/* 区块 */
.block {
  margin: 10px 16px 0;
  padding: 14px;
}

.block-title {
  font-size: 13.5px;
  font-weight: 600;
  color: #101828;
  margin-bottom: 10px;
}

.notice {
  font-size: 12.5px;
  color: #475467;
  line-height: 1.85;
  white-space: pre-wrap;
}

.rich {
  font-size: 12.5px;
  color: #475467;
  line-height: 1.8;
}

/* 规格 */
.spec-group {
  margin-bottom: 14px;
}

.spec-group:last-child {
  margin-bottom: 0;
}

.spec-label {
  font-size: 12.5px;
  color: #667085;
  margin-bottom: 9px;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.spec {
  font-size: 12.5px;
  color: #475467;
  background: #f4f6f8;
  border: 1px solid #f4f6f8;
  border-radius: 8px;
  padding: 7px 14px;
  line-height: 1.2;
}

.spec.on {
  background: #e7f8f0;
  border-color: #12b76a;
  color: #0f9a59;
  font-weight: 600;
}

.num-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.num-group .spec-label {
  margin-bottom: 0;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1px solid #e4e7ec;
  border-radius: 8px;
  overflow: hidden;
}

.step {
  width: 34px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #344054;
  background: #fafbfc;
}

.step.dim {
  color: #d0d5dd;
}

.step-input {
  width: 46px;
  height: 32px;
  text-align: center;
  font-size: 13px;
  color: #101828;
  border-left: 1px solid #e4e7ec;
  border-right: 1px solid #e4e7ec;
}

.stock-row {
  display: flex;
  gap: 14px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #f2f4f7;
}

/* 详情内容与底部购买栏之间的留白（含 iPhone 底部安全区） */
.end-gap {
  height: calc(env(safe-area-inset-bottom) + 220rpx);
}

/* 底部 */
.icon-btn {
  width: 46px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  font-size: 10px;
  color: #667085;
  flex: 0 0 46px;
}

.ico-service {
  width: 21px;
  height: 21px;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23667085' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 12a8 8 0 0 1 16 0v5a3 3 0 0 1-3 3h-3'/%3E%3Crect x='2.5' y='12' width='3.5' height='6' rx='1.6'/%3E%3Crect x='18' y='12' width='3.5' height='6' rx='1.6'/%3E%3C/svg%3E");
}

.buy-btn {
  flex: 1;
  height: 46px;
  border-radius: 12px;
  background: #12b76a;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buy-btn.disabled {
  background: #d0d5dd;
}

.err-actions {
  display: flex;
  gap: 10px;
  justify-content: center;
  margin-top: 16px;
}
