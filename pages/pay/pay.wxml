<!-- pages/pay/pay.wxml -->
<view class="paypage">
  <view wx:if="{{paid}}" class="state">
    <view class="state-ico ok">✓</view>
    <view class="state-title">支付成功</view>
    <view class="muted">正在为你打开发货内容…</view>
  </view>

  <block wx:else>
    <!-- 金额 -->
    <view class="amount-card">
      <view class="amount-label">待支付金额</view>
      <view class="amount"><text class="unit">¥</text>{{amountText || '—'}}</view>
      <view wx:if="{{name}}" class="amount-name">{{name}}</view>
      <view class="amount-timer">
        <text wx:if="{{!expired}}">支付剩余时间 {{leftText}}</text>
        <text wx:else class="expired">支付已超时，点击下方「继续支付」可重新发起</text>
      </view>
    </view>

    <!-- 二维码 -->
    <view class="qr-card">
      <view class="qr-head">
        <text class="qr-title">{{linkLabel}}</text>
        <text class="qr-sub">长按二维码识别，在微信内完成付款</text>
      </view>

      <view class="qr-box">
        <canvas id="qr" type="2d" class="qr-canvas" style="width:220px;height:220px"></canvas>
        <image
          wx:if="{{qrImage}}"
          class="qr-image"
          src="{{qrImage}}"
          mode="aspectFit"
          show-menu-by-longpress="{{true}}"
        />
        <view wx:if="{{qrError}}" class="qr-fallback">
          <view class="big">⚠</view>
          <view class="qr-err">{{qrError}}</view>
        </view>
      </view>

      <view class="qr-tip">付款后系统自动发货，无需等待人工审核</view>

      <view class="qr-actions">
        <view class="btn small ghost" bindtap="copyLink">复制支付链接</view>
        <view class="btn small ghost" bindtap="checkNow">{{checking ? '查询中…' : '我已完成支付'}}</view>
      </view>

      <!-- 超时后不再要求重新下单，直接就地重新发起支付 -->
      <view wx:if="{{canContinue}}" class="btn continue-btn" bindtap="continuePay">继续支付</view>
    </view>

    <view wx:if="{{tip}}" class="pane tip">{{tip}}</view>

    <view class="order-no">
      <text class="muted">订单号</text>
      <text class="mono">{{tradeNo}}</text>
    </view>

    <view class="help-row">
      <text class="link" bindtap="gotoOrders">查看我的订单</text>
      <text class="dot">·</text>
      <text class="link" bindtap="gotoHelp">遇到问题</text>
    </view>
  </block>
</view>
