/* pages/category/category.wxss */
/* 顶部渐变头由 app.wxss 的 .screen-hero 提供，本页不再单独写白底导航区 */
.catpage {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.cat-hero {
  padding-bottom: 14px;
  flex: 0 0 auto;
}

.split {
  flex: 1;
  display: flex;
  min-height: 0;
}

/* 左侧一级类目：暖米色侧栏，不抢右侧商品卡 */
.side {
  width: 96px;
  flex: 0 0 96px;
  background: #f4ecdf;
  height: 100%;
}

.side-item {
  padding: 15px 10px;
  font-size: 12.5px;
  color: var(--ink-sub);
  text-align: center;
  position: relative;
  line-height: 1.35;
}

/* 选中项取页面底色，与右侧内容区连成一片 */
.side-item.on {
  background: var(--paper);
  color: var(--ink);
  font-weight: 600;
}

.side-item.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 16px;
  background: var(--brand);
  border-radius: 0 2px 2px 0;
}

.side-empty {
  padding: 20px 10px;
  font-size: 12px;
  color: var(--ink-dim);
  text-align: center;
}

/* 右侧商品区：透明底，跟随页面暖砂色，仅卡片为白色 */
.main {
  flex: 1;
  height: 100%;
  background: transparent;
  padding: 0 12px;
  min-width: 0;
}

.main-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14px 2px 8px;
}

.main-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--ink);
}

.main-count {
  font-size: 11px;
  color: var(--ink-dim);
}

.sub-scroll {
  white-space: nowrap;
  margin-bottom: 4px;
}

.sub-row {
  display: flex;
  gap: 7px;
  padding-bottom: 6px;
}

.sub {
  flex: 0 0 auto;
  font-size: 11.5px;
  color: var(--ink-sub);
  background: #f4ecdf;
  border-radius: 6px;
  padding: 5px 10px;
  line-height: 1.2;
}

.sub.on {
  background: var(--brand-l);
  color: var(--brand-d);
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 6px;
}

.gcard {
  width: 48.5%;
  background: #fff;
  border: 1px solid #f2e8da;
  border-radius: 11px;
  overflow: hidden;
  margin-bottom: 10px;
}

.gcover {
  position: relative;
  height: 104px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.gimg {
  width: 100%;
  height: 100%;
}

.ginitial {
  font-size: 30px;
  font-weight: 700;
  color: rgba(58, 44, 28, 0.18);
}

.soldout {
  position: absolute;
  inset: 0;
  background: rgba(58, 44, 28, 0.45);
  color: #fff;
  font-size: 11.5px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gbody {
  padding: 8px 9px 9px;
}

.gname {
  font-size: 12px;
  line-height: 1.4;
  height: 34px;
  color: var(--ink);
}

.gfoot {
  display: flex;
  align-items: baseline;
  margin-top: 5px;
}

.gfoot .price {
  font-size: 14px;
}

.gsold {
  margin-left: auto;
  font-size: 9.5px;
  color: var(--ink-dim);
}

.retry-btn {
  display: inline-block;
  margin-top: 14px;
  font-size: 13px;
  color: var(--brand);
  border: 1px solid #eadcc7;
  border-radius: 8px;
  padding: 7px 18px;
}
