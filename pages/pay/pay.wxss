/* pages/pay/pay.wxss */
.paypage {
  min-height: 100vh;
  background: #faf6f0;
  padding: 12px 16px 30px;
}

/* 金额 */
.amount-card {
  background: linear-gradient(160deg, #a3672a, #8a5522);
  border-radius: 16px;
  padding: 20px 18px 16px;
  text-align: center;
  color: #fff;
}

.amount-label {
  font-size: 12px;
  color: #eeddc4;
}

.amount {
  font-size: 34px;
  font-weight: 700;
  margin-top: 6px;
  letter-spacing: 0.5px;
}
.amount .unit {
  font-size: 17px;
  margin-right: 2px;
}

.amount-name {
  font-size: 12px;
  color: #eeddc4;
  margin-top: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.amount-timer {
  margin-top: 14px;
  font-size: 11.5px;
  color: #f3e6d3;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 999px;
  display: inline-block;
  padding: 5px 14px;
}

.amount-timer .expired {
  color: #ffb4a8;
}

/* 二维码 */
.qr-card {
  background: #fff;
  border-radius: 16px;
  margin-top: 12px;
  padding: 18px 16px 16px;
  text-align: center;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}

.qr-head {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.qr-title {
  font-size: 14.5px;
  font-weight: 600;
  color: #101828;
}

.qr-sub {
  font-size: 11.5px;
  color: #98a2b3;
}

.qr-box {
  margin: 14px auto 0;
  width: 220px;
  height: 220px;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
}

.qr-canvas {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

.qr-image {
  width: 220px;
  height: 220px;
  display: block;
}

.qr-fallback {
  position: absolute;
  inset: 0;
  background: #f8f3ea;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.qr-err {
  font-size: 11.5px;
  color: #667085;
  line-height: 1.7;
  margin-top: 6px;
}

.qr-tip {
  font-size: 11.5px;
  color: #c07b3a;
  margin-top: 14px;
}

.qr-actions {
  display: flex;
  gap: 10px;
  margin-top: 14px;
}

.qr-actions .btn {
  flex: 1;
}

/* 超时后的主按钮 */
.continue-btn {
  margin-top: 12px;
  background: #3a2c1c;
}

/* 其它 */
.tip {
  margin-top: 12px;
  font-size: 12px;
  color: #475467;
  line-height: 1.75;
  white-space: pre-wrap;
}

.order-no {
  margin-top: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 11.5px;
  color: #98a2b3;
}

.help-row {
  margin-top: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 12.5px;
}

.link {
  color: #c07b3a;
}

.dot {
  color: #d0d5dd;
}

/* 成功态 */
.state {
  padding-top: 90px;
  text-align: center;
}

.state-ico {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  color: #fff;
}

.state-ico.ok {
  background: #12b76a;
}

.state-title {
  font-size: 18px;
  font-weight: 600;
  color: #3a2c1c;
  margin-bottom: 6px;
}
