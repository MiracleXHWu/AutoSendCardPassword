/* pages/goods/goods.wxss */

/* ---------------- 商品头部 ---------------- */
.hero {
  position: relative;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(160deg, #eafaf1 0%, #ffffff 72%);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(18, 183, 106, 0.14) 0%, rgba(18, 183, 106, 0) 70%);
}

.hero-chip {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(18, 183, 106, 0.12);
  color: var(--brand-dark);
  margin-bottom: 20rpx;
}

.hero-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.hero-price {
  position: relative;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------------- 价格未配置警告卡 ---------------- */
.cfgcard {
  border: 2rpx solid #ffd9a8;
  background: linear-gradient(180deg, #fffaf2 0%, #ffffff 60%);
}

.cfgcard-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.cfgcard-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  line-height: 52rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cfgcard-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.cfgcard-item {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.cfgcard-dev {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  color: #fff;
  background: var(--warn);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  margin: 8rpx 0 14rpx;
}

/* 价格待维护时的占位文字（替代会误导人的「¥—」） */
.price-todo {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-3);
}

.cfgcard-btn {
  margin-top: 20rpx;
}

/* ---------------- 你将获得 ---------------- */
.perk {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}

.perk-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  text-align: center;
  line-height: 60rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.perk-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink-2);
  padding-top: 8rpx;
}

/* ---------------- 发货流程 ---------------- */
.step {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.step-n {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14c46f, #059a57);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.step-t {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* ---------------- 购买须知 ---------------- */
.notice {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-2);
  white-space: pre-line;
}

.contact {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: #576b95;
  text-align: left;
}

.contact::after {
  border: none;
}

/* ---------------- 骨架屏 ---------------- */
.s-title {
  height: 48rpx;
  width: 72%;
  margin-bottom: 26rpx;
}

.s-line {
  height: 26rpx;
  width: 100%;
  margin-bottom: 18rpx;
}

.s-short {
  width: 56%;
}

.s-price {
  height: 56rpx;
  width: 38%;
  margin-top: 32rpx;
}
