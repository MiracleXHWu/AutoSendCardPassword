/* pages/mine/mine.wxss */
.minepage {
  min-height: 100vh;
  background: var(--paper);
}

/* 头部：渐变底与圆角由 app.wxss 的 .screen-hero 统一提供 */
.user {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 4px;
}

.avatar {
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #a3672a;
  font-size: 20px;
  font-weight: 600;
}

.uname {
  color: #3a2c1c;
  font-size: 17px;
  font-weight: 600;
}

.ustatus {
  color: #8a7458;
  font-size: 11px;
  margin-top: 4px;
}

.login-btn {
  color: #a3672a;
  font-size: 12px;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(58, 44, 28, 0.18);
  border-radius: 999px;
  padding: 6px 14px;
  flex: 0 0 auto;
}

.phone-row {
  margin-top: 16px;
  display: flex;
  align-items: center;
  padding: 11px 13px;
}

.phone-label {
  color: #8a7458;
  font-size: 12px;
  width: 60px;
}

.phone-val {
  flex: 1;
  color: #3a2c1c;
  font-size: 12.5px;
}

.phone-arrow {
  color: #c0aa8b;
  font-size: 14px;
}

/* 统计 */
.stats-card {
  margin: -14px 16px 0;
  position: relative;
  background: #fff;
  border-radius: 14px;
  padding: 15px 0;
  display: flex;
  box-shadow: 0 6px 18px -12px rgba(90, 64, 32, 0.24);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .n {
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
}

.stat .n.amber {
  color: #d9822b;
}

.stat .n.green {
  color: #4f9d6b;
}

.stat .l {
  font-size: 10.5px;
  color: var(--ink-dim);
  margin-top: 3px;
}

/* 菜单 */
.menu {
  margin: 12px 16px 0;
  background: #fff;
  border-radius: 13px;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 14px 14px;
  font-size: 13.5px;
  color: #4a3a28;
}

.menu-item + .menu-item {
  border-top: 1px solid #f4ece0;
}

.mi-ico {
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.mi-order {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c07b3a' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M5 4.6A1.6 1.6 0 0 1 6.6 3h10.8A1.6 1.6 0 0 1 19 4.6V21l-3.5-2.2L12 21l-3.5-2.2L5 21z'/%3E%3Cpath d='M9 8.4h6M9 12.4h4'/%3E%3C/svg%3E");
}

.mi-search {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b0813f' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='11' cy='11' r='7'/%3E%3Cpath d='M16.5 16.5 21 21'/%3E%3C/svg%3E");
}

.mi-help {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d9822b' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='9'/%3E%3Cpath d='M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3M12 17h.01'/%3E%3C/svg%3E");
}

.mi-info {
  background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23b9a894' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='9'/%3E%3Cpath d='M12 11v5M12 8h.01'/%3E%3C/svg%3E");
}

.mi-text {
  flex: 1;
}

.mi-arrow {
  color: #d8c9b4;
  font-size: 15px;
}

/* 其它 */
.logout {
  margin: 14px 16px 0;
  text-align: center;
  font-size: 12.5px;
  color: #f04438;
  background: #fff;
  border-radius: 12px;
  padding: 13px;
}

.foot {
  text-align: center;
  margin-top: 26px;
  font-size: 11.5px;
  color: #b9a894;
}
