<!-- pages/goods/goods.wxml -->
<view class="goodspage">
  <block wx:if="{{loading}}">
    <view class="cover skeleton" style="height:300px"></view>
    <view class="pane" style="margin:-18px 16px 0;position:relative">
      <view class="skeleton" style="height:22px;width:40%"></view>
      <view class="skeleton" style="height:16px;width:90%;margin-top:12px"></view>
      <view class="skeleton" style="height:16px;width:60%;margin-top:8px"></view>
    </view>
  </block>

  <view wx:elif="{{error}}" class="empty">
    <view class="big">⚠</view>
    <view>{{error}}</view>
    <view class="err-actions">
      <view class="btn small ghost" bindtap="retry">重试</view>
      <view class="btn small dark" bindtap="gotoHome">返回首页</view>
    </view>
  </view>

  <block wx:else>
    <!-- 封面 -->
    <view class="cover">
      <image wx:if="{{!noCover}}" class="cover-img" src="{{detail.cover}}" mode="aspectFill" />
      <view wx:else class="cover-blank">
        <text class="cover-initial">{{detail.name[0]}}</text>
      </view>
    </view>

    <!-- 主信息 -->
    <view class="main-card">
      <view class="price-row">
        <view class="price big"><text class="unit">¥</text>{{priceLoading ? '…' : priceText}}</view>
        <text wx:if="{{detail.hasDiscount}}" class="price-origin">¥{{detail.priceText}}</text>
        <text class="sold">已售 {{detail.sold}}</text>
      </view>
      <view class="title">{{detail.name}}</view>
      <view class="meta">
        <text class="tag" wx:for="{{detail.tags}}" wx:key="name">{{item.name}}</text>
        <text wx:if="{{detail.seckill}}" class="tag red">限时抢购</text>
        <text class="muted">{{detail.deliveryWay === 0 ? '付款后自动发货' : '人工发货'}}</text>
      </view>
    </view>

    <!-- 规格 / 数量 -->
    <view class="pane block">
      <view wx:if="{{detail.races.length}}" class="spec-group">
        <view class="spec-label">选择种类</view>
        <view class="spec-values">
          <view
            class="spec {{race === item.name ? 'on' : ''}}"
            wx:for="{{detail.races}}"
            wx:key="name"
            data-name="{{item.name}}"
            bindtap="selectRace"
          >{{item.name}}</view>
        </view>
      </view>

      <view wx:for="{{detail.skuGroups}}" wx:for-item="group" wx:key="name" class="spec-group">
        <view class="spec-label">{{group.name}}</view>
        <view class="spec-values">
          <view
            class="spec {{sku[group.name] === value ? 'on' : ''}}"
            wx:for="{{group.values}}"
            wx:for-item="value"
            wx:key="*this"
            data-group="{{group.name}}"
            data-value="{{value}}"
            bindtap="selectSku"
          >{{value}}</view>
        </view>
      </view>

      <view class="spec-group num-group">
        <view class="spec-label">购买数量</view>
        <view class="stepper">
          <view class="step {{num <= min ? 'dim' : ''}}" bindtap="minus">−</view>
          <input class="step-input" type="number" value="{{num}}" bindblur="onNumInput" />
          <view class="step" bindtap="plus">＋</view>
        </view>
      </view>

      <view class="stock-row">
        <text class="muted">库存 {{stockText || stock}}</text>
        <text wx:if="{{detail.minimum > 0}}" class="muted">起购 {{detail.minimum}} 件</text>
        <text wx:if="{{detail.maximum > 0}}" class="muted">限购 {{detail.maximum}} 件</text>
      </view>
    </view>

    <!-- 购买须知 -->
    <view wx:if="{{detail.leaveMessage}}" class="pane block">
      <view class="block-title">购买须知</view>
      <view class="notice">{{detail.leaveMessage}}</view>
    </view>

    <!-- 图文详情 -->
    <view wx:if="{{descHtml}}" class="pane block">
      <view class="block-title">商品详情</view>
      <rich-text class="rich" nodes="{{descHtml}}"></rich-text>
    </view>

    <view wx:else class="pane block">
      <view class="block-title">商品详情</view>
      <view class="muted">商家暂未填写图文详情，如有疑问可联系客服。</view>
    </view>

    <!-- 底部留白：避免最后一段文字贴着购买栏 -->
    <view class="end-gap"></view>

    <!-- 底部操作 -->
    <view class="action-bar">
      <view class="icon-btn" bindtap="gotoHelp">
        <view class="ico-service"></view>
        <text>客服</text>
      </view>
      <view class="buy-btn {{canBuy ? '' : 'disabled'}}" bindtap="buy">
        {{canBuy ? '立即购买' : '已售罄'}}
      </view>
    </view>
  </block>
</view>
