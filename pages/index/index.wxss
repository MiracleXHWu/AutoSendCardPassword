/* pages/index/index.wxss */
.index {
  padding-bottom: 0;
}

/* ---------- Hero ---------- */
.hero {
  background: linear-gradient(168deg, #0f2a1d 0%, #0b1a14 100%);
  padding-left: 18px;
  padding-right: 18px;
  padding-bottom: 18px;
  border-radius: 0 0 22px 22px;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 6px;
}

.brand {
  color: #fff;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.slogan {
  color: #8fb3a2;
  font-size: 11.5px;
  margin-top: 5px;
}

.cat-entry {
  color: #c8e6d6;
  font-size: 12px;
  border: 1px solid rgba(200, 230, 214, 0.28);
  border-radius: 999px;
  padding: 5px 11px;
  margin-top: 2px;
}

.srch {
  margin-top: 16px;
  height: 38px;
  border-radius: 19px;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 8px;
}

.srch-ico {
  width: 14px;
  height: 14px;
  border: 1.6px solid #9fc4b2;
  border-radius: 50%;
  position: relative;
  flex: 0 0 auto;
}
.srch-ico::after {
  content: '';
  position: absolute;
  right: -3px;
  bottom: -2px;
  width: 6px;
  height: 1.6px;
  background: #9fc4b2;
  transform: rotate(45deg);
}

.srch-txt {
  color: #9fc4b2;
  font-size: 12.5px;
}

.hero-stats {
  margin-top: 16px;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 10px 0;
}

.hs {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-n {
  color: #fff;
  font-size: 15px;
  font-weight: 700;
}

.hs-l {
  color: #7fa290;
  font-size: 10.5px;
  margin-top: 2px;
}

.hs-line {
  width: 1px;
  height: 22px;
  background: rgba(255, 255, 255, 0.1);
}

/* ---------- 分类 ---------- */
.cat-scroll {
  margin-top: 12px;
  white-space: nowrap;
}

.cat-row {
  display: flex;
  gap: 8px;
  padding: 0 16px 4px;
}

.cat {
  flex: 0 0 auto;
  font-size: 12.5px;
  color: #475467;
  background: #fff;
  border: 1px solid #e4e7ec;
  padding: 6px 14px;
  border-radius: 999px;
  line-height: 1.2;
}

.cat.on {
  background: #101828;
  color: #fff;
  border-color: #101828;
  font-weight: 600;
}

/* ---------- 网格 ---------- */
.body {
  padding: 6px 16px 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.gcard {
  width: 48.6%;
  background: #fff;
  border-radius: 13px;
  overflow: hidden;
  margin-bottom: 12px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}

.gcover {
  position: relative;
  height: 132px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.gimg {
  width: 100%;
  height: 100%;
  display: block;
}

.ginitial {
  font-size: 38px;
  font-weight: 700;
  color: rgba(16, 24, 40, 0.16);
}

/* 推荐角标：红色底，与「限时」的绿色区分开 */
.badge {
  position: absolute;
  left: 7px;
  top: 7px;
  font-size: 9.5px;
  color: #fff;
  background: #f04438;
  padding: 2px 6px;
  border-radius: 4px;
  line-height: 1.4;
}

.badge.right {
  left: auto;
  right: 7px;
  background: #12b76a;
}

.soldout {
  position: absolute;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  color: #fff;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1px;
}

.gbody {
  padding: 9px 10px 10px;
}

.gname {
  font-size: 12.5px;
  line-height: 1.45;
  height: 36px;
  color: #101828;
}

.gtags {
  margin-top: 5px;
  height: 16px;
  overflow: hidden;
}

.gfoot {
  display: flex;
  align-items: baseline;
  margin-top: 7px;
}

.gfoot .price {
  font-size: 15px;
}

.gsold {
  margin-left: auto;
  font-size: 10px;
  color: #98a2b3;
}

.retry-btn {
  display: inline-block;
  margin-top: 14px;
  font-size: 13px;
  color: #12b76a;
  border: 1px solid #b7e8cf;
  border-radius: 8px;
  padding: 7px 18px;
}
