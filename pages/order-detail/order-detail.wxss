/* pages/order-detail/order-detail.wxss */
.detailpage {
  min-height: 100vh;
  background: #faf6f0;
  padding: 12px 16px 24px;
}

/* 状态条 */
.status-bar {
  display: flex;
  gap: 12px;
  align-items: center;
  border-radius: 14px;
  padding: 16px 15px;
  color: #fff;
}

.status-bar.ok {
  background: linear-gradient(140deg, #0f8f52, #12b76a);
}

.status-bar.wait {
  background: linear-gradient(140deg, #b57409, #f79009);
}

.sb-ico {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17px;
  font-weight: 700;
}

.sb-title {
  font-size: 15px;
  font-weight: 600;
}

.sb-sub {
  font-size: 11.5px;
  opacity: 0.86;
  margin-top: 3px;
}

/* 区块 */
.block {
  margin-top: 11px;
  padding: 14px;
}

.block-title {
  font-size: 13.5px;
  font-weight: 600;
  color: #101828;
  margin-bottom: 10px;
}

.copy {
  font-size: 11.5px;
  color: #12b76a;
  flex: 0 0 auto;
  margin-left: 10px;
}

/* 卡密 */
.secret {
  background: #f7f8fa;
  border: 1px solid #eef0f3;
  border-radius: 10px;
  padding: 13px;
}

.secret-text {
  font-family: ui-monospace, Menlo, Consolas, monospace;
  font-size: 13px;
  line-height: 1.7;
  color: #101828;
  word-break: break-all;
  white-space: pre-wrap;
  display: block;
}

.secret-empty {
  padding: 8px 0;
}

/* 密码 */
.pwd-box {
  background: #fffbf2;
  border: 1px solid #fdeccd;
  border-radius: 10px;
  padding: 12px;
}

.pwd-row {
  display: flex;
  gap: 9px;
  margin-top: 10px;
}

.pwd-input {
  flex: 1;
  height: 34px;
  background: #fff;
  border: 1px solid #f0e2c4;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 13px;
}

.ph {
  color: #b0b8c4;
}

/* 留言 */
.leave {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed #eef0f3;
}

.leave-title {
  font-size: 11.5px;
  color: #98a2b3;
  margin-bottom: 5px;
}

.leave-body {
  font-size: 12.5px;
  color: #475467;
  line-height: 1.75;
  white-space: pre-wrap;
}

/* 信息 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 0;
  font-size: 12.5px;
}

.info-row + .info-row {
  border-top: 1px solid #f7f8fa;
}

.lbl {
  color: #98a2b3;
  flex: 0 0 auto;
}

.val {
  color: #101828;
  text-align: right;
}

.val-row {
  display: flex;
  align-items: center;
}

/* 帮助入口 */
.help-entry {
  margin-top: 14px;
  text-align: center;
  font-size: 12px;
  color: #667085;
  background: #fff;
  border-radius: 12px;
  padding: 13px;
}
